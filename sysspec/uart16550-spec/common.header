linux/module, linux/kernel, linux/serial_core, linux/serial_reg, linux/tty, linux/tty_flip, linux/interrupt, linux/ioport, linux/spinlock, asm/io, hw_ops

#define UART_SYSSPEC_PORT_SIZE   8
#define UART_SYSSPEC_FIFO_SIZE   16
#define UART_SYSSPEC_UARTCLK     1843200

/* Register offsets relative to port->iobase (8250/16550 layout). */
#define UART_SYSSPEC_RX          0
#define UART_SYSSPEC_TX          0
#define UART_SYSSPEC_IER         1
#define UART_SYSSPEC_IIR         2
#define UART_SYSSPEC_FCR         2
#define UART_SYSSPEC_LCR         3
#define UART_SYSSPEC_MCR         4
#define UART_SYSSPEC_LSR         5
#define UART_SYSSPEC_MSR         6
#define UART_SYSSPEC_DLL         0
#define UART_SYSSPEC_DLM         1
